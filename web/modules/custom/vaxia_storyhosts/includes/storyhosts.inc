<?php

/**
 * @file
 * Storyhosts (D7 storyhosts): SH eligibility, storyhost characters, session
 * report notes.
 */

use Drupal\node\NodeInterface;
use Drupal\taxonomy\Entity\Term;
use Drupal\user\Entity\User;
use Drupal\user\UserInterface;
use Drupal\vaxia_core\Character;

const VAXIA_STORYHOSTS_FOOTER = "\n\n~~~~~~\nThis email was automatically generated by [site:name].\nYou are receiving this email as part of your membership at [site:name].\nDo not reply this this email, it is not a monitored account and messages will not be received by a human.\n~~~~~~";

/**
 * Sends a plain mail.
 */
function vaxia_storyhosts_send(string $to, string $subject, string $body): void {
  \Drupal::service('plugin.manager.mail')->mail('vaxia_storyhosts', 'text', $to, 'en', ['subject' => $subject, 'body' => $body . VAXIA_STORYHOSTS_FOOTER]);
}

/**
 * Sends a mail to every active user with any of the roles.
 */
function vaxia_storyhosts_send_to_roles(array $roles, string $subject, string $body): void {
  $ids = \Drupal::entityQuery('user')->accessCheck(FALSE)->condition('status', 1)->condition('roles', $roles, 'IN')->execute();
  foreach (User::loadMultiple($ids) as $account) {
    vaxia_storyhosts_send($account->getEmail(), $subject, $body);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for users: players past 39 XP earned
 * become eligible for the SH course.
 */
function vaxia_storyhosts_user_presave(UserInterface $account) {
  if ($account->isNew() || $account->isBlocked() || !$account->hasRole('player') || $account->hasRole('eligible_for_sh')
    || !$account->hasField('field_xp_over_time') || (float) $account->get('field_xp_over_time')->value <= 39) {
    return;
  }
  $account->addRole('eligible_for_sh');
  vaxia_storyhosts_send($account->getEmail(), '[site:mail-prefix] You are eligible to become a Storyhost',
    "Hi,\n\nYou have been with us for 40 XP worth of posting and RP. We wanted to let you know that you qualify now for the Storyhost course if you're interested in joining the A/SH group. We can always use more Storyhosts, so please check out the following link if you are interested:\n\n[site:url]/wiki/sh-course\n\nThank you for being a valuable member of our community - we're glad to have you.");
}

/**
 * Storyhost characters go in the Storyhost realm, titled ASH.
 */
function vaxia_storyhosts_storyhost_character_presave(NodeInterface $node): void {
  if (!$node->isNew() || $node->bundle() !== 'character_sheet' || !$node->hasField('field_is_storyteller') || !$node->get('field_is_storyteller')->value) {
    return;
  }
  $tids = \Drupal::entityQuery('taxonomy_term')->accessCheck(FALSE)->condition('vid', 'realm')->condition('name', 'Storyhost')->range(0, 1)->execute();
  if (!$tids) {
    $term = Term::create(['vid' => 'realm', 'name' => 'Storyhost']);
    $term->save();
    $tids = [$term->id()];
  }
  $node->set('field_tag_realm', reset($tids));
  $node->set('field_titles', 'ASH');
}

/**
 * New storyhost characters become their author's storyhost character and are
 * approved.
 */
function vaxia_storyhosts_storyhost_character_insert(NodeInterface $node): void {
  if ($node->bundle() !== 'character_sheet' || !$node->hasField('field_is_storyteller') || !$node->get('field_is_storyteller')->value) {
    return;
  }
  $author = User::load($node->getOwnerId());
  if ($author && $author->id()) {
    $author->set('field_storyhost_character', $node->id());
    $author->save();
  }
  Character::forceStateLater($node, 'character_evaluation_approved', 'Storyhost characters are auto approved');
}

/**
 * Session report notes are for those allowed to see them.
 */
function vaxia_storyhosts_session_view(array &$build, NodeInterface $node): void {
  if ($node->bundle() === 'session_report' && !\Drupal::currentUser()->hasPermission('view session notes')) {
    unset($build['field_additional_notes']);
  }
}
