<?php

/**
 * @file
 * Site events (D7 site_events, timeline_events).
 */

use Drupal\comment\Entity\Comment;
use Drupal\node\Entity\Node;
use Drupal\vaxia_core\Cron;

/**
 * Implements hook_cron(): nightly reminders for tomorrow's events.
 */
function vaxia_events_cron() {
  if (Cron::onceADay('site_events_send_reminders', '23:00:00')) {
    vaxia_events_send_reminders();
  }
}

/**
 * Published, scheduled events starting tomorrow (D7 looked at the day after
 * tomorrow and didn't skip cancelled events).
 */
function vaxia_events_tomorrow(): array {
  $timezone = new \DateTimeZone(date_default_timezone_get());
  $start = new \DateTime('tomorrow', $timezone);
  $end = (clone $start)->modify('+1 day');
  $utc = new \DateTimeZone('UTC');
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(FALSE)->condition('type', 'event')->condition('status', 1)
    ->condition('field_when.value', $start->setTimezone($utc)->format('Y-m-d\TH:i:s'), '>=')
    ->condition('field_when.value', $end->setTimezone($utc)->format('Y-m-d\TH:i:s'), '<')
    ->execute();
  return array_filter($storage->loadMultiple($ids), fn($n) => !$n->hasField('field_event_status') || $n->get('field_event_status')->value !== 'event_status_cancelled');
}

function vaxia_events_send_reminders(): void {
  $mailer = \Drupal::service('plugin.manager.mail');
  $footer = "\n\n~~~~~~\nThis email was automatically generated by [site:name].\nYou are receiving this email as part of your membership at [site:name].\nDo not reply this this email, it is not a monitored account and messages will\nnot be received by a human.\n~~~~~~";
  foreach (vaxia_events_tomorrow() as $event) {
    $body = "You have an event scheduled for tomorrow. Please check for any last minute signups or messages at:\n\n" . $event->label() . "\n" . $event->toUrl('canonical', ['absolute' => TRUE])->toString() . $footer;
    $organizer = $event->getOwner();
    if ($organizer && $organizer->isActive()) {
      $mailer->mail('vaxia_events', 'text', $organizer->getEmail(), 'en', ['subject' => '[site:mail-prefix] You have an event tomorrow', 'body' => $body]);
    }
    // Each attendee's latest answer counts.
    $latest = [];
    $cids = \Drupal::entityQuery('comment')->accessCheck(FALSE)->condition('entity_id', $event->id())->condition('entity_type', 'node')->condition('status', 1)->sort('cid')->execute();
    foreach (Comment::loadMultiple($cids) as $comment) {
      $latest[$comment->getOwnerId()] = $comment;
    }
    foreach ($latest as $comment) {
      $attendee = $comment->getOwner();
      if ($attendee && $attendee->isActive() && $comment->bundle() === 'comment_node_event' && $comment->get('field_attendance')->value === 'yes') {
        $mailer->mail('vaxia_events', 'text', $attendee->getEmail(), 'en', ['subject' => '[site:mail-prefix] You have an event scheduled for tomorrow', 'body' => $body]);
      }
    }
  }
}

/**
 * Implements hook_mail().
 */
function vaxia_events_mail($key, &$message, $params) {
  $message['subject'] = $params['subject'];
  $message['body'][] = $params['body'];
}
